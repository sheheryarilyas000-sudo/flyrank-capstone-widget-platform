# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (SQLite — no Docker required) ---
# The default points to a local file in the project root.
# Use sqlite+aiosqlite:///:memory: for fast in-memory tests.
DATABASE_URL=sqlite+aiosqlite:///./database.db

# --- Application ---
APP_ENV=development          # development | staging | production
SECRET_KEY=replace_with_a_long_random_secret
LOG_LEVEL=INFO

# --- Rate Limiting ---
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=10

# --- IP Geo-Location (optional fallback chain) ---
# Leave blank to skip geo-tagging; the app degrades gracefully.
IPAPI_KEY=
IPSTACK_KEY=
